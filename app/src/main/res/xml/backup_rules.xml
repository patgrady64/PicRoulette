<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        PicRoulette stores persisted Storage Access Framework URIs and favorite
        URI mappings in PicRoulettePrefs. Those grants are device-specific and
        should not be restored onto another device.
    -->
    <exclude domain="sharedpref" path="PicRoulettePrefs.xml" />

    <!--
        Internal files are library caches containing content:// URIs. They are
        rebuilt from the folders the user grants on the current device.
    -->
    <exclude domain="file" path="." />
</full-backup-content>
